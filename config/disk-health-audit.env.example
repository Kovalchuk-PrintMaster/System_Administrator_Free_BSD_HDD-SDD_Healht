# EXAMPLE ONLY. Do not place real credentials in Git.
# Keys are sourced from the original env's NAMES ONLY, not its values.
# Some keys may be ignored by the current script. Validate before production.
# When copying into the protected real env, restrict to root: chmod 600.

REPORT_ROOT=""
POLL_SEC="60"
STAGGER_SEC="5"
EXTRA_ARGS=""
RUNS_CLEANUP_ENABLED="yes"
RUNS_RETENTION_DAYS="180"
TELEGRAM_ENABLED="no"
TELEGRAM_SEND_DOCUMENT="yes"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_API_URL="https://api.telegram.org"
TELEGRAM_DISABLE_NOTIFICATION="true"
